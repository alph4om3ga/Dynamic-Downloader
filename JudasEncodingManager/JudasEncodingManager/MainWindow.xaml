                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,12">
                                        <TextBlock Text="Logs Folder (Encoding session logs)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding LogsFolder, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,12">
