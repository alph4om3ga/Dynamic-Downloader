                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- qBittorrent Tab -->
            <TabItem Header="📥 qBittorrent" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- qBittorrent Selector -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0" 
                                         Content="🖥️ Local qBittorrent" 
                                         GroupName="QBitSelector"
                                         IsChecked="{Binding IsLocalQBitSelected}"
                                         Style="{StaticResource ModernRadioButton}"
                                         Margin="0,0,16,0"/>
                            
                            <RadioButton Grid.Column="1" 
                                         Content="🌐 Seedbox qBittorrent" 
                                         GroupName="QBitSelector"
                                         IsChecked="{Binding IsSeedboxQBitSelected}"
                                         Style="{StaticResource ModernRadioButton}"
                                         Margin="0,0,16,0"/>

                            <Button Grid.Column="2" Content="🔄 Refresh" 
                                    Command="{Binding RefreshQBitCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"/>

                            <TextBlock Grid.Column="3" 
                                       Text="{Binding CurrentQBitUrl}" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <Border Grid.Column="4" 
                                    Background="{Binding QBitConnectionStatus, Converter={StaticResource ConnectionStatusColorConverter}}"
                                    CornerRadius="4" Padding="8,4" Margin="8,0,0,0">
                                <TextBlock Text="{Binding QBitConnectionStatus}" FontSize="11"/>
                            </Border>

                            <Button Grid.Column="5" Content="⚙️" 
                                    Command="{Binding OpenQBitSettingsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Open Connection Settings"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- WebView Container -->
                    <Border Grid.Row="1" 
                            Background="{StaticResource SurfaceBrush}" 
                            CornerRadius="8" 
                            Margin="0,16,0,0"
                            Padding="2">
                        <Grid>
                            <!-- Local qBittorrent WebView -->
                            <wv2:WebView2 x:Name="LocalQBitWebView"
                                          Visibility="{Binding IsLocalQBitSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            
                            <!-- Seedbox qBittorrent WebView -->
                            <wv2:WebView2 x:Name="SeedboxQBitWebView"
                                          Visibility="{Binding IsSeedboxQBitSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Loading/Error Overlay -->
                            <Border Background="{StaticResource BackgroundBrush}" 
                                    Visibility="{Binding IsQBitLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🔄" FontSize="48" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Connecting to qBittorrent..." 
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="16" Margin="0,16,0,0"/>
                                    <TextBlock Text="{Binding CurrentQBitUrl}" 
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- No URL Configured Message -->
                            <Border Background="{StaticResource BackgroundBrush}" 
                                    Visibility="{Binding IsQBitUrlEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="⚠️" FontSize="48" HorizontalAlignment="Center"/>
                                    <TextBlock Text="qBittorrent URL not configured" 
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="16" Margin="0,16,0,0"/>
                                    <TextBlock Text="Go to Connections tab to set up qBittorrent WebUI URL" 
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,8,0,0"/>
                                    <Button Content="Open Connection Settings" 
                                            Command="{Binding OpenQBitSettingsCommand}"
                                            Style="{StaticResource ModernButton}"
                                            HorizontalAlignment="Center"
                                            Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- CRD Tab -->
            <TabItem Header="🎬 CRD" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,16,0,0" DataContext="{Binding CRDViewModel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Status + Controls -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Margin="0,0,16,0">

                        <!-- Status Card -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="CRD Status" Style="{StaticResource SectionHeader}"/>

                                <!-- Running indicator -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="12" Height="12"
                                            CornerRadius="6"
                                            Background="{Binding IsRunning, Converter={StaticResource BoolToColorConverter}}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RunningStatusText}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Version: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding InstalledVersion}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Status}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <!-- Action buttons -->
                                <Button Content="🚀 Launch CRD"
                                        Command="{Binding LaunchCRDCommand}"
                                        Style="{StaticResource ModernButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"/>
                                <Button Content="⟳ Run CRD Updater"
                                        Command="{Binding RunUpdaterCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"/>
                                <Button Content="🔄 Refresh Status"
                                        Command="{Binding RefreshStatusCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <!-- Info Card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="About CRD" Style="{StaticResource SectionHeader}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Crunchy-DL (CRD)" FontWeight="SemiBold"/>
                                    <Run Text=" is the primary download source. Configure your shows in the Weekly Shows tab by selecting CRD as the download method and pointing it at the output folder. JEM detects new downloads automatically and starts encoding."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Polling schedule per show:" FontWeight="SemiBold"/>
                                    <LineBreak/>
                                    <Run Text="• Every 1 min for first 10 min"/>
                                    <LineBreak/>
                                    <Run Text="• Every 10 min for next 1 hour"/>
                                    <LineBreak/>
                                    <Run Text="• Every 30 min for next 6 hours"/>
                                    <LineBreak/>
                                    <Run Text="• Stop — wait until next scheduled airing"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Activity Log -->
                    <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="CRD Activity Log" Style="{StaticResource SectionHeader}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding ActivityLog, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         VerticalAlignment="Top"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Automation Tab -->
            <TabItem Header="🤖 Automation" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <!-- Control Panel -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Start/Stop Monitoring -->
                            <Button Grid.Column="0" Content="▶️ Start Monitoring" 
                                    Command="{Binding Automation.StartMonitoringCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Visibility="{Binding Automation.IsMonitoring, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                    Margin="0,0,8,0"/>
                            <Button Grid.Column="0" Content="⏹️ Stop Monitoring" 
                                    Command="{Binding Automation.StopMonitoringCommand}"
                                    Style="{StaticResource DangerButton}"
                                    Visibility="{Binding Automation.IsMonitoring, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,8,0"/>

                            <!-- Pause/Resume -->
                            <Button Grid.Column="1" Content="⏸️ Pause" 
                                    Command="{Binding Automation.PauseQueueCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Visibility="{Binding Automation.IsPaused, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                    IsEnabled="{Binding Automation.IsMonitoring}"
                                    Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="▶️ Resume" 
                                    Command="{Binding Automation.ResumeQueueCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Visibility="{Binding Automation.IsPaused, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,8,0"/>

                            <!-- Cancel Current -->
                            <Button Grid.Column="2" Content="🚫 Cancel Current" 
                                    Command="{Binding Automation.CancelCurrentProcessCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding Automation.IsProcessing}"
                                    Margin="0,0,8,0"/>

                            <!-- Stop All -->
                            <Button Grid.Column="3" Content="🛑 STOP ALL" 
                                    Command="{Binding Automation.StopAllProcessingCommand}"
                                    Style="{StaticResource DangerButton}"
                                    ToolTip="Stop monitoring and cancel all in-progress operations"
                                    Margin="0,0,8,0"/>

                            <!-- Direct Download via CRD -->
                            <Button Grid.Column="5" Content="🎬 Launch CRD"
                                    Command="{Binding CRDViewModel.LaunchCRDCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Launch Crunchy-DL to download directly from Crunchyroll"
                                    Margin="0,0,16,0"/>

                            <!-- RSS Interval -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="RSS Check Interval:" 
                                           Foreground="{StaticResource TextBrush}" 
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding Automation.RssCheckInterval, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" Width="50"/>
                                <TextBlock Text="min" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>

                            <!-- Status -->
                            <Border Grid.Column="6" 
                                    Background="{Binding Automation.MonitoringStatus, Converter={StaticResource MonitoringStatusColorConverter}}"
                                    CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Automation.MonitoringStatus}" 
                                           FontWeight="SemiBold" FontSize="12"/>
                            </Border>

                            <!-- Queue Summary -->
                            <TextBlock Grid.Column="7" 
                                       Text="{Binding Automation.QueueSummary}" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" FontSize="11"/>
                        </Grid>
                    </Border>

                    <!-- Queue Panel -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Queue" Style="{StaticResource SectionHeader}"/>

                            <ListBox Grid.Row="1" 
                                     ItemsSource="{Binding Automation.Queue}"
                                     SelectedItem="{Binding Automation.SelectedQueueItem}"
                                     Style="{StaticResource ModernListBox}"
                                     ItemContainerStyle="{StaticResource ModernListBoxItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                                       Text="{Binding OutputFileName}" 
                                                       FontWeight="SemiBold"/>
                                            
                                            <Border Grid.Row="0" Grid.Column="1" 
                                                    Background="{Binding Status, Converter={StaticResource QueueStatusColorConverter}}"
                                                    CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Status}" FontSize="10"/>
                                            </Border>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Text="{Binding StatusMessage}" 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"/>

                                            <!-- Progress Bar for active items -->
                                            <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                         Value="{Binding EncodeProgress}" Maximum="1"
                                                         Height="4" Margin="0,4,0,0"
                                                         Visibility="{Binding Status, Converter={StaticResource EncodingStatusToVisibilityConverter}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="⬆ Up"
                                        Command="{Binding Automation.MoveQueueItemUpCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        ToolTip="Move the selected pending item earlier in the queue"/>
                                <Button Content="⬇ Down"
                                        Command="{Binding Automation.MoveQueueItemDownCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        ToolTip="Move the selected pending item later in the queue"/>
                                <Button Content="🔄 Retry" 
                                        Command="{Binding Automation.RetryFailedItemCommand}"
                                        Style="{StaticResource ModernButton}" Margin="0,0,8,0"/>
                                <Button Content="🗑️ Remove" 
                                        Command="{Binding Automation.RemoveQueueItemCommand}"
                                        Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                                <Button Content="🧹 Clear Completed" 
                                        Command="{Binding Automation.ClearCompletedItemsCommand}"
                                        Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right Column: Test Run + Activity Log -->
                    <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Test Run Panel -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="🧪 Test Run" Style="{StaticResource SectionHeader}"/>

                                <!-- Show Selection -->
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding Shows}"
                                              SelectedItem="{Binding Automation.TestRunSelectedShow}"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource ModernComboBox}"/>
                                    <Button Grid.Column="1"
                                            Content="{Binding Automation.LoadTestRunButtonLabel}"
                                            Command="{Binding Automation.LoadTestRunRssItemsCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="8,0,0,0"/>
                                </Grid>

                                <!-- Episode Source -->
                                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Episode Source"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <RadioButton Content="🎬 CRD"
                                                         IsChecked="{Binding Automation.TestRunSourceIsCRD}"
                                                         Foreground="{StaticResource TextBrush}"
                                                         Margin="0,0,12,0"
                                                         GroupName="TestRunSource"
                                                         ToolTip="Scan the CRD output folder for downloaded episode files"/>
                                            <RadioButton Content="📡 RSS"
                                                         IsChecked="{Binding Automation.TestRunSourceIsRSS}"
                                                         Foreground="{StaticResource TextBrush}"
                                                         GroupName="TestRunSource"
                                                         ToolTip="Load episodes from the show's Nyaa RSS feed"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Episode Selection -->
                                <ComboBox Grid.Row="3" 
                                          ItemsSource="{Binding Automation.TestRunRssItems}"
                                          SelectedItem="{Binding Automation.TestRunSelectedEpisode}"
                                          DisplayMemberPath="Title"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,8,0,0"
                                          IsEnabled="{Binding Automation.TestRunRssItems.Count}"/>

                                <!-- Test Mode Toggle -->
                                <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" 
                                        CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Pipeline Mode" 
                                                   Foreground="{StaticResource TextBrush}" 
                                                   FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <RadioButton Content="Simulate" 
                                                         IsChecked="{Binding Automation.IsSimulatedTest}"
                                                         Foreground="{StaticResource TextBrush}"
                                                         Margin="0,0,12,0"/>
                                            <RadioButton Content="Real" 
                                                         IsChecked="{Binding Automation.IsRealTest}"
                                                         Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Encode Type Toggle (only when Real is selected) -->
                                <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}" 
                                        CornerRadius="4" Padding="8" Margin="0,4,0,0"
                                        IsEnabled="{Binding Automation.CanSelectEncodeOptions}"
                                        Opacity="{Binding Automation.CanSelectEncodeOptions, Converter={StaticResource BoolToOpacityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Encode Type" 
                                                   Foreground="{StaticResource TextBrush}" 
                                                   FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <RadioButton Content="Quick (5 min)" 
                                                         IsChecked="{Binding Automation.IsQuickEncode}"
                                                         Foreground="{StaticResource TextBrush}"
                                                         Margin="0,0,12,0"
                                                         GroupName="EncodeType"/>
                                            <RadioButton Content="Full Episode" 
                                                         IsChecked="{Binding Automation.IsFullEncode}"
                                                         Foreground="{StaticResource TextBrush}"
                                                         GroupName="EncodeType"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Post Visibility Toggle (only when Real is selected) -->
                                <Border Grid.Row="6" Background="{StaticResource SurfaceBrush}" 
                                        CornerRadius="4" Padding="8" Margin="0,4,0,0"
                                        IsEnabled="{Binding Automation.CanSelectEncodeOptions}"
                                        Opacity="{Binding Automation.CanSelectEncodeOptions, Converter={StaticResource BoolToOpacityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Nyaa Visibility" 
                                                   Foreground="{StaticResource TextBrush}" 
                                                   FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <RadioButton Content="Hidden" 
                                                         IsChecked="{Binding Automation.IsHiddenPost}"
                                                         Foreground="{StaticResource TextBrush}"
                                                         Margin="0,0,12,0"
                                                         GroupName="PostVisibility"/>
                                            <RadioButton Content="Public" 
                                                         IsChecked="{Binding Automation.IsPublicPost}"
                                                         Foreground="{StaticResource TextBrush}"
                                                         GroupName="PostVisibility"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Description -->
                                <TextBlock Grid.Row="7" 
                                           Text="{Binding Automation.TestModeDescription}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10" TextWrapping="Wrap" FontStyle="Italic"
                                           Margin="0,8,0,0"/>

                                <!-- Status -->
                                <TextBlock Grid.Row="8" 
                                           Text="{Binding Automation.TestRunStatus}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>

                                <!-- Action Buttons Row -->
                                <Grid Grid.Row="9" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Progress bar (shown while running) -->
                                    <ProgressBar Grid.Column="0"
                                                 Value="{Binding Automation.TestRunProgress}"
                                                 Maximum="100"
                                                 Height="6"
                                                 Margin="0,0,8,0"
                                                 Visibility="{Binding Automation.IsTestRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Queue Release — always visible when an episode is selected -->
                                    <Button Grid.Column="1"
                                            Content="📋 Queue Release"
                                            Command="{Binding Automation.QueueManualReleaseCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,0"
                                            ToolTip="Add this episode to the main queue as a full (non-test) release. Use this to catch up on missed episodes — multiple episodes can be queued."/>

                                    <!-- Start Test Run / Cancel -->
                                    <Button Grid.Column="2" Content="🚀 Start Test"
                                            Command="{Binding Automation.StartTestRunCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Visibility="{Binding Automation.IsTestRunning, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <Button Grid.Column="2" Content="🛑 Cancel"
                                            Command="{Binding Automation.CancelTestRunCommand}"
                                            Style="{StaticResource DangerButton}"
                                            Visibility="{Binding Automation.IsTestRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Activity Log Panel -->
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock Text="Activity Log" Style="{StaticResource SectionHeader}"/>
                                    <Button Content="🧹 Clear" 
                                            Command="{Binding Automation.ClearActivityLogCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Padding="8,4"/>
                                </Grid>

                                <ListBox Grid.Row="1" 
                                         ItemsSource="{Binding Automation.ActivityLog}"
                                         Style="{StaticResource ModernListBox}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" 
                                                           Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" 
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10" Margin="0,0,8,0"
                                                           VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding Message}" 
                                                           Foreground="{Binding Level, Converter={StaticResource LogLevelColorConverter}}"
                                                           FontSize="11" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{Binding StatusMessage}" 
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="{Binding HasUnsavedChanges, Converter={StaticResource UnsavedChangesColorConverter}}"
                            CornerRadius="4" Padding="8,4" Margin="0,0,8,0"
                            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Unsaved Changes" FontSize="11"/>
                    </Border>
                    <TextBlock Text="v1.3" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
