                                                       Foreground="{StaticResource TextBrush}" 
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                            <Button Content="🗑️ Clear Temp Folder Now" 
                                                    Command="{Binding ClearTempFolderCommand}"
                                                    Style="{StaticResource DangerButton}" 
                                                    Margin="0,0,8,0"/>
                                            <Button Content="🧹 Clean Old Logs" 
                                                    Command="{Binding CleanOldLogsCommand}"
                                                    Style="{StaticResource SecondaryButton}" 
                                                    Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding TempFolderSize}" 
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Temp Folder Structure Info -->
                                <TextBlock Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold">Temp folder structure:</Run><LineBreak/>
                                    <Run>• video/ - Encoded .hevc/.h265 video files</Run><LineBreak/>
                                    <Run>• audio-subs/ - Extracted audio and subtitle tracks</Run><LineBreak/>
                                    <Run>• data/ - CSV encode statistics</Run><LineBreak/>
                                    <Run>• done/ - Processed source files (moved after encode)</Run>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Connections Tab -->
            <TabItem Header="🔗 Connections" Style="{StaticResource ModernTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel MaxWidth="800">
                        <!-- qBittorrent -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="qBittorrent WebUI" Style="{StaticResource SectionHeader}"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

