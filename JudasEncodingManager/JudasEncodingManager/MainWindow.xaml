                                            Content="Reset 28-day timer"
                                            Command="{Binding ResetNyaaCookieSessionTimerCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            ToolTip="Use after entering fresh Nyaa session information"/>
                                </Grid>

                                <TextBlock Text="How to get cookies: Open nyaa.si → Login → Press F12 → Application tab → Cookies → Copy __ddlg and session values" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Quick Setup - AniDex -->
                        <Border Style="{StaticResource Card}">
