<Window x:Class="JudasEncodingManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JudasEncodingManager.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Judas Encoding Manager" 
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewFileCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Menu Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo/Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="⚡" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Judas Encoding Manager" 
                               FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Test Mode Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="{Binding IsTestMode, Converter={StaticResource TestModeColorConverter}}"
                            CornerRadius="4" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧪" Margin="0,0,6,0"/>
                            <TextBlock Text="TEST MODE" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <CheckBox Content="Enable Test Mode" 
                              IsChecked="{Binding IsTestMode}" 
                              Style="{StaticResource ModernCheckBox}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- File Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="📁 Open" Command="{Binding OpenFileCommand}" 
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="💾 Save" Command="{Binding SaveFileCommand}" 
                            Style="{StaticResource ModernButton}" Margin="0,0,8,0"/>
                    <Button Content="📄 Save As" Command="{Binding SaveFileAsCommand}" 
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Nyaa session reminder stays visible while browsing every tab. -->
        <Border Grid.Row="1"
                Margin="16,8,16,0"
                Padding="12,8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{Binding NyaaCookieSessionStatusBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Nyaa session:" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding NyaaCookieSessionStatus}"
                           Foreground="{Binding NyaaCookieSessionStatusBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="2" 
                    Style="{StaticResource ModernTabControl}"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="16">
            
            <!-- Shows Tab -->
            <TabItem Header="📺 Weekly Shows" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Show List -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Shows" Style="{StaticResource SectionHeader}"/>

                            <ListBox Grid.Row="1" 
                                     ItemsSource="{Binding SortedShows}"
                                     SelectedItem="{Binding SelectedShow}"
                                     Style="{StaticResource ModernListBox}"
                                     ItemContainerStyle="{StaticResource ModernListBoxItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" 
                                                    Background="{StaticResource SurfaceBrush}"
                                                    CornerRadius="4" Padding="6,4" 
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"
                                                    MinWidth="36">
                                                <TextBlock Text="{Binding ShortReleaseDay}" 
                                                           FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11">
                                                    <Run Text="{Binding ReleaseTime, Mode=OneWay}"/> - <Run Text="{Binding ProgressText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{Binding DownloadMethodColor}"
                                                        CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding ShortDownloadMethod}"
                                                               FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <Border Background="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}"
                                                        CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                                               FontSize="10"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="➕ Add" Command="{Binding AddShowCommand}" 
                                        Style="{StaticResource ModernButton}" Margin="0,0,8,0"/>
                                <Button Content="📋 Copy" Command="{Binding DuplicateShowCommand}" 
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                                <Button Content="🗑️" Command="{Binding RemoveShowCommand}" 
                                        Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                                        ToolTip="Remove Show"/>
                                <Button Content="🔄" Command="{Binding RefreshSortCommand}" 
                                        Style="{StaticResource SecondaryButton}"
                                        ToolTip="Sort by Day/Time"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Show Details -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedShow}" 
                                    IsEnabled="{Binding DataContext.SelectedShow, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToBoolConverter}}">
                            
                            <!-- Basic Info -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Basic Information" Style="{StaticResource SectionHeader}"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                            <TextBlock Text="Torrent Title (Full Name)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding OutputTorrentTitle, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                                            <TextBlock Text="File Title (Short Name)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding OutputFileTitle, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                                            <TextBlock Text="Season Number" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding SeasonNumber, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                                            <TextBlock Text="INI Script Name" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding IniScriptName, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Source Group" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding SourceGroup, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Episode Offset" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding NumberOfEpisodesToRemoveFromCount, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Download Source -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Download Source" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                               Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="Priority order:"/>
                                        <Run Text=" CRD (Crunchyroll Direct)" FontWeight="SemiBold"/>
                                        <Run Text="→"/>
                                        <Run Text="RSS / Torrent" FontWeight="SemiBold"/>
                                    </TextBlock>

                                    <!-- Method selector -->
                                    <TextBlock Text="Download Method" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox SelectedIndex="{Binding DownloadMethodIndex}"
                                              Style="{StaticResource ModernComboBox}"
                                              ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                                              Margin="0,0,0,16">
                                        <ComboBoxItem Content="🎬 CRD — Crunchyroll Direct (primary)"/>
                                        <ComboBoxItem Content="📡 RSS — Nyaa/Torrent (secondary)"/>
                                    </ComboBox>

                                    <!-- ── CRD fields (visible when method = CRD) ── -->
                                    <StackPanel Visibility="{Binding UsesCRD, Converter={StaticResource BoolToVisibilityConverter}}">

                                        <!-- CRD Output Folder -->
                                        <TextBlock Text="CRD Output Folder" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap">
                                            The folder where CRD saves downloaded episodes for this show.
                                            JEM watches this folder on the release schedule and picks up new files automatically.
                                        </TextBlock>
                                        <TextBox Text="{Binding CrdOutputPath, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Margin="0,0,0,12"/>

                                        <!-- File Match Pattern -->
                                        <TextBlock Style="{StaticResource FieldLabel}">
                                            <Run Text="File Match Pattern"/>
                                            <Run Text="  e.g. TowerOfGod*.mkv  (blank = *.mkv)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        </TextBlock>
                                        <TextBox Text="{Binding CrdFilePattern, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}"
                                                 FontFamily="Consolas"
                                                 Margin="0,0,0,12"/>

                                        <!-- How it works note -->
                                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,8">
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="⚙ How it works:" FontWeight="SemiBold"/>
                                                <Run Text=" When a new episode file appears in the output folder, JEM moves it to the Encoding folder and starts encoding automatically."/>
                                                <LineBreak/>
                                                <Run Text="⏱ Check schedule:" FontWeight="SemiBold"/>
                                                <Run Text=" Every 1 min for 10 min → every 10 min for 1 hr → every 30 min for 6 hrs → stop until next airing."/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- ── RSS fields (visible when method = RSS) ── -->
                                    <StackPanel Visibility="{Binding UsesRSS, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="RSS Feed URL" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding RssFeed, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Margin="0,0,0,12"/>
                                        <TextBlock Text="Custom Episode Regex (Optional)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding CustomEpisodeRegex, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Margin="0,0,0,4"/>
                                        <TextBlock Text="Extract episode numbers from non-standard filenames"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <!-- Schedule -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Release Schedule" Style="{StaticResource SectionHeader}"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Release Day" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox SelectedIndex="{Binding ReleaseDayIndex}" 
                                                      Style="{StaticResource ModernComboBox}"
                                                      ItemContainerStyle="{StaticResource ModernComboBoxItem}">
                                                <ComboBoxItem Content="Not Set"/>
                                                <ComboBoxItem Content="Sunday"/>
                                                <ComboBoxItem Content="Monday"/>
                                                <ComboBoxItem Content="Tuesday"/>
                                                <ComboBoxItem Content="Wednesday"/>
                                                <ComboBoxItem Content="Thursday"/>
                                                <ComboBoxItem Content="Friday"/>
                                                <ComboBoxItem Content="Saturday"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                            <TextBlock Text="Release Time" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding ReleaseTime, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock Text="Expected Episodes" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding ExpectedEpisodes, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernTextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Status -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Status &amp; Options" Style="{StaticResource SectionHeader}"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <CheckBox Content="Active (Monitor for new episodes)" 
                                                      IsChecked="{Binding IsActive}" 
                                                      Style="{StaticResource ModernCheckBox}" 
                                                      Margin="0,0,0,8"/>
                                            <CheckBox Content="Auto-post to trackers" 
                                                      IsChecked="{Binding AutopostOnTrackers}" 
                                                      Style="{StaticResource ModernCheckBox}"
                                                      Margin="0,0,0,8"/>
                                            <CheckBox Content="Uncensored Release" 
                                                      IsChecked="{Binding IsUncensored}" 
                                                      Style="{StaticResource ModernCheckBox}"
                                                      ToolTip="Adds [Uncensored] tag to torrent name"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="Progress" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock Text="{Binding ProgressText}" 
                                                       FontSize="24" FontWeight="Bold" 
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Manual Episode Management -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Episode Management" Style="{StaticResource SectionHeader}"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Episode #:" 
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBox Grid.Column="1" 
                                                 Text="{Binding DataContext.ManualEpisodeNumber, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                        <Button Grid.Column="2" Content="➕ Add Episode" 
                                                Command="{Binding DataContext.AddManualEpisodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource ModernButton}" 
                                                Margin="8,0,0,0"/>
                                        <Button Grid.Column="3" Content="➖ Remove Last" 
                                                Command="{Binding DataContext.RemoveLastEpisodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource SecondaryButton}" 
                                                Margin="8,0,0,0"/>
                                        <Button Grid.Column="5" Content="🗑️ Clear All History" 
                                                Command="{Binding DataContext.ClearEpisodeHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource DangerButton}"/>
                                    </Grid>

                                    <TextBlock Text="Latest Released Episodes:" 
                                               Style="{StaticResource FieldLabel}" 
                                               Margin="0,16,0,4"/>
                                    <ItemsControl ItemsSource="{Binding EpisodesReleased}" MaxHeight="100">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2">
                                                    <Run Text="Episode"/>
                                                    <Run Text="{Binding EpisodeNumber, Mode=OneWay}"/>
                                                    <Run Text="{Binding Version, Mode=OneWay, StringFormat=' (v{0})'}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding ReleaseDate, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- RSS Feed Test -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="RSS Feed Test" Style="{StaticResource SectionHeader}"/>
                                    
                                    <TextBlock Text="Current RSS Feed:" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding RssFeed, Mode=OneWay}" 
                                             Style="{StaticResource ModernTextBox}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             Margin="0,0,0,12"/>

                                    <Button Content="🔍 Test RSS Feed" 
                                            Command="{Binding DataContext.TestRssFeedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource ModernButton}" 
                                            HorizontalAlignment="Left"
                                            IsEnabled="{Binding DataContext.IsTestingRss, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolConverter}}"/>

                                    <Border Background="{StaticResource SurfaceBrush}" 
                                            CornerRadius="4" 
                                            Padding="12" 
                                            Margin="0,12,0,0"
                                            Visibility="{Binding DataContext.RssTestResult, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="{Binding DataContext.RssTestResult, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- General Settings Tab -->
            <TabItem Header="⚙️ General" Style="{StaticResource ModernTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel MaxWidth="800">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Machine Settings" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Machine Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Border>

                        <!-- Color Scheme -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="🎨 Appearance" Style="{StaticResource SectionHeader}"/>
                                
                                <TextBlock Text="Color Scheme" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ColorSchemes}"
                                          SelectedItem="{Binding SelectedColorScheme}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource ModernComboBox}"
                                          ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                                          Margin="0,0,0,12"/>

                                <!-- Color Preview -->
                                <TextBlock Text="Preview" Style="{StaticResource FieldLabel}"/>
                                <Border Background="{Binding PreviewBackgroundBrush}" 
                                        CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{Binding PreviewPrimaryBrush}" 
                                                    CornerRadius="4" Padding="12,6" Margin="0,0,8,0">
                                                <TextBlock Text="Primary" Foreground="White" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="{Binding PreviewAccentBrush}" 
                                                    CornerRadius="4" Padding="12,6" Margin="0,0,8,0">
                                                <TextBlock Text="Accent" Foreground="White" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="{Binding PreviewCardBrush}" 
                                                    CornerRadius="4" Padding="12,6">
                                                <TextBlock Text="Card" Foreground="White" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{Binding PreviewSuccessBrush}" 
                                                    CornerRadius="4" Padding="8,4" Margin="0,0,4,0">
                                                <TextBlock Text="Success" Foreground="White" FontSize="11"/>
                                            </Border>
                                            <Border Background="{Binding PreviewWarningBrush}" 
                                                    CornerRadius="4" Padding="8,4" Margin="0,0,4,0">
                                                <TextBlock Text="Warning" Foreground="White" FontSize="11"/>
                                            </Border>
                                            <Border Background="{Binding PreviewErrorBrush}" 
                                                    CornerRadius="4" Padding="8,4">
                                                <TextBlock Text="Error" Foreground="White" FontSize="11"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Button Content="🎨 Apply Color Scheme" 
                                        Command="{Binding ApplyColorSchemeCommand}"
                                        Style="{StaticResource ModernButton}"
                                        HorizontalAlignment="Left"/>
                                <TextBlock Text="Changes will apply immediately and be saved with settings" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Image Hosting API Keys" Style="{StaticResource SectionHeader}"/>
                                
                                <TextBlock Text="ImgBB API Key" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ImgbbApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                                <TextBlock Text="FreeImage API Key" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding FreeimageApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Tool Paths" Style="{StaticResource SectionHeader}"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                        <TextBlock Text="mkvmerge Path" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding MkvmergePath, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <Button Grid.Row="0" Grid.Column="1" Content="Browse" 
                                            Command="{Binding BrowseMkvmergeCommand}"
                                            Style="{StaticResource SecondaryButton}" 
                                            VerticalAlignment="Bottom" Margin="0,0,0,12"/>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="FFmpeg Path" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <Button Grid.Row="1" Grid.Column="1" Content="Browse" 
                                            Command="{Binding BrowseFfmpegCommand}"
                                            Style="{StaticResource SecondaryButton}" 
                                            VerticalAlignment="Bottom"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CRD Configuration -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="🎬 CRD — Crunchy Downloader" Style="{StaticResource SectionHeader}"/>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    CRD.exe is the primary download source for Crunchyroll episodes.
                                    JEM monitors the output folder on the release schedule and queues files for encoding.
                                    Use the CRD tab to launch the app or run its built-in updater.
                                </TextBlock>

                                <!-- Path row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
