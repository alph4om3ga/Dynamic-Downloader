                                            Style="{StaticResource SecondaryButton}" 
                                            VerticalAlignment="Bottom" Margin="0,0,0,12"/>

                                    <!-- Screenshots Folder -->
                                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,12">
                                        <TextBlock Text="Screenshots Folder (Captured screenshots)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding ScreenshotsFolder, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <Button Grid.Row="4" Grid.Column="1" Content="Browse" 
                                            Command="{Binding BrowseScreenshotsFolderCommand}"
                                            Style="{StaticResource SecondaryButton}" 
                                            VerticalAlignment="Bottom" Margin="0,0,0,12"/>

                                    <!-- Seeding Folder -->
                                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Seeding Folder (Final releases for seeding)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SeedingFolder, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <Button Grid.Row="5" Grid.Column="1" Content="Browse" 
                                            Command="{Binding BrowseSeedingFolderCommand}"
                                            Style="{StaticResource SecondaryButton}" 
