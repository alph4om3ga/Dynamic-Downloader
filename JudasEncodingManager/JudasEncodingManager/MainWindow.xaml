                                        <TextBlock Style="{StaticResource FieldLabel}">
                                            <Run Text="Temp Folder"/>
                                            <Run Text="(video/, audio-subs/, data/, done/)" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </TextBlock>
                                        <TextBox Text="{Binding TempFolder, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,12">
