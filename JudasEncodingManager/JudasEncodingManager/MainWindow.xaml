                                                        <Run Text="{Binding Type}"/> - <Run Text="{Binding EndpointUrl}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Border Grid.Column="2" 
                                                        Background="{Binding Enabled, Converter={StaticResource BoolToColorConverter}}"
