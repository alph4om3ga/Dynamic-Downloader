                                        <TextBlock Text="Local IP:Port" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding QBitLocalIpPort, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,12">
                                        <TextBlock Text="Seedbox IP:Port" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding QBitSeedboxIpPort, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding QBitSeedboxUsername, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding QBitSeedboxPassword, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="Releases Path" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding QBitSeedboxReleasesPath, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- FTP -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="FTP Server" Style="{StaticResource SectionHeader}"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,12">
                                        <TextBlock Text="Host" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding FtpHost, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,8,12">
                                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding FtpUsername, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="8,0,0,12">
                                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding FtpPassword, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Releases Path" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding FtpReleasesPath, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Torrents Path" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding FtpTorrentsPath, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Discord -->
