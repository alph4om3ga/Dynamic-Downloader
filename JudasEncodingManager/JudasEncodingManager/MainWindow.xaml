                                    <Run FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">AniDex</Run> - API key authentication<LineBreak/>
                                    <Run FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">TokyoTosho</Run> - API-based posting<LineBreak/>
                                    <Run FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">AnimeTosho</Run> - Automatic scraping (no upload needed)<LineBreak/>
                                    <Run FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">Custom</Run> - Configure your own endpoint with custom credentials
                                </TextBlock>
                            </StackPanel>
