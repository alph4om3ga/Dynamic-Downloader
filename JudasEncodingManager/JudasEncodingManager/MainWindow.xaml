                                                  IsChecked="{Binding AutoClearTempOnSuccess}" 
                                                  Style="{StaticResource ModernCheckBox}"
                                                  Margin="0,0,0,8"/>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="Keep logs for" 
                                                       Foreground="{StaticResource TextBrush}" 
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding KeepLogsDays, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernTextBox}" 
                                                     Width="50"/>
