                            <StackPanel>
                                <TextBlock Text="Discord" Style="{StaticResource SectionHeader}"/>
                                
                                <TextBlock Text="Webhook URL" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                                <TextBlock Text="Server Invite Link" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding DiscordServerInviteLink, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                                <TextBlock Text="Bot Token (Optional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding DiscordBotToken, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Border>

                        <!-- Telegram -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Telegram (Optional)" Style="{StaticResource SectionHeader}"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Bot Token" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Chat ID" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Auto Posting Tab -->
            <TabItem Header="📤 Auto Posting" Style="{StaticResource ModernTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel MaxWidth="900">
                        <!-- Quick Setup - Nyaa -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Nyaa.si (Primary)" Style="{StaticResource SectionHeader}"/>
                                    <Border Grid.Column="1" 
                                            Background="{StaticResource SuccessBrush}"
                                            CornerRadius="4" Padding="8,4" VerticalAlignment="Top">
                                        <TextBlock Text="Default" FontSize="11" Foreground="White"/>
                                    </Border>
                                </Grid>
                                
                                <TextBlock Text="Cookie: __ddlg" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NyaaCookieDdlg, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                                <TextBlock Text="Cookie: session" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NyaaCookieSession, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}" 
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True"
                                         Height="60" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
