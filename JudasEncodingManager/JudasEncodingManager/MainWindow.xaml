                                                Command="{Binding BrowseLogsFolderCommand}"
                                                Style="{StaticResource SecondaryButton}" 
                                                Margin="0,0,4,0"/>
                                        <Button Content="📂" 
                                                Command="{Binding OpenLogsFolderCommand}"
                                                Style="{StaticResource SecondaryButton}" 
