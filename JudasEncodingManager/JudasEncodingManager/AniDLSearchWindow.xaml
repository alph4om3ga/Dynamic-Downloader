<Window x:Class="JudasEncodingManager.AniDLSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Direct Download — aniDL"
        Height="680" Width="820"
        MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="📥 Direct Download via aniDL"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Search Crunchyroll, Hidive, or AnimationDigitalNetwork and download directly — bypassing RSS/torrent."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Service + Search -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Service:" 
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Services}"
                          SelectedItem="{Binding SelectedService}"
                          Style="{StaticResource ModernComboBox}"
                          Margin="0,0,12,0"/>

                <TextBox Grid.Column="2"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="3"
                        Content="🔍 Search"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource ModernButton}"
                        IsEnabled="{Binding IsNotBusy}"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="4"
                        Content="🔑 Auth"
                        Command="{Binding AuthCommand}"
                        Style="{StaticResource SecondaryButton}"
                        ToolTip="Launch interactive authentication for selected service"/>
            </Grid>
        </Border>

        <!-- Search Results + Download Config -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Results list -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Search Results" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedResult}"
                             Style="{StaticResource ModernListBox}"
                             ItemContainerStyle="{StaticResource ModernListBoxItem}"
                             Height="120"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="["/><Run Text="{Binding Id}"/><Run Text="] "/>
                                        <Run Text="{Binding Title}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Type}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="✅ Use Selected"
                            Command="{Binding SelectResultCommand}"
                            CommandParameter="{Binding SelectedResult}"
                            Style="{StaticResource ModernButton}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            IsEnabled="{Binding HasSelectedResult}"/>
                </StackPanel>

                <!-- Separator -->
                <Border Grid.Column="1" Width="1" Background="{StaticResource SurfaceBrush}" Margin="8,0"/>

                <!-- Download config -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Download Configuration" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>

                    <TextBlock Text="Season ID" Style="{StaticResource FieldLabel}" FontSize="11"/>
                    <TextBox Text="{Binding SeasonId, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,8"/>

                    <TextBlock Text="Episodes (blank = all)" Style="{StaticResource FieldLabel}" FontSize="11"/>
                    <TextBox Text="{Binding EpisodeSelection, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,4"/>

                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10">
                        <Run Text="Examples: "/>
                        <Run Text="1" FontWeight="SemiBold"/>
                        <Run Text=" · "/>
                        <Run Text="1-12" FontWeight="SemiBold"/>
                        <Run Text=" · "/>
                        <Run Text="1,3,5" FontWeight="SemiBold"/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="⬇️ Download"
                                Command="{Binding DownloadCommand}"
                                Style="{StaticResource ModernButton}"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="0,0,8,0"/>
                        <Button Content="🚫 Cancel"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource DangerButton}"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Output log -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Output" Style="{StaticResource SectionHeader}"/>
                    <Button Content="🧹 Clear"
                            Command="{Binding ClearOutputCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="8,4"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              x:Name="OutputScroll">
                    <TextBox Text="{Binding OutputText, Mode=OneWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             FontFamily="Consolas, Courier New"
                             FontSize="11"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Disabled"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}"
                CornerRadius="4" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Busy spinner -->
                    <TextBlock Text="⏳" Margin="0,0,8,0" FontSize="13"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="⏳" Margin="0,0,8,0" FontSize="13"
                               Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Close"
                        Click="CloseButton_Click"
                        Style="{StaticResource SecondaryButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
